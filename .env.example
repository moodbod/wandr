# Vercel / Expo public build variables
# Set these in Vercel for Production, Preview, and Development as needed.
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Native Mapbox downloads token. Keep this secret; set it locally or in EAS.
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=

# Optional public integrations
EXPO_PUBLIC_TENOR_API_KEY=

# Convex backend variables
# Set these with `bunx convex env set ...` on the target Convex deployment.
CONVEX_SITE_URL=
SITE_URL=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
BOOKING_COM_API_BASE=https://demandapi.booking.com/3.2
BOOKING_COM_API_TOKEN=
BOOKING_COM_AFFILIATE_ID=
BOOKING_COM_SYNC_ENABLED=false
BOOKING_COM_SYNC_COUNTRIES=

# Local Convex CLI selection only. Do not set this in Vercel unless your deploy flow requires it.
CONVEX_DEPLOYMENT=
